# Copy to .env and fill in. NEVER commit .env.
# SQLAlchemy needs the cockroachdb+psycopg:// scheme (not plain postgresql://).
DATABASE_URL=cockroachdb+psycopg://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# Optional: a read-only role for the agent's generated SQL (preferred).
DATABASE_URL_READONLY=

# LLM provider config (provider-agnostic wrapper reads these)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Guard / safety defaults
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_LIMIT=200
